# RippleGuard Environment Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (SQLite default for zero-docker, PostgreSQL connection string also supported)
DATABASE_URL="file:./rippleguard.db"

# External Security Data APIs
OSV_API_URL="https://api.osv.dev/v1"
EPSS_API_URL="https://api.first.org/data/v1/epss"
DEPSDEV_API_URL="https://api.deps.dev/v3"

# GitHub PR Gate Threshold (Risk >= threshold blocks merge, 0-100)
RIPPLEGUARD_RISK_THRESHOLD=70

# Optional GitHub Personal Access Token or App Token for posting PR comments
GITHUB_TOKEN=""

# Mock / Demo Mode fallback (if external APIs unavailable or offline)
ENABLE_OFFLINE_MOCK_FALLBACK=true
